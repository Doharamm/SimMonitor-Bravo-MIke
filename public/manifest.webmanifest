{
  "id": "./",
  "name": "Bravo Mike SimMonitor",
  "short_name": "SimMonitor",
  "description": "Monitor multiparamétrico e controle remoto para simulação de urgência e emergência.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#07090c",
  "theme_color": "#07090c",
  "icons": [
    { "src": "img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Monitor", "short_name": "Monitor", "description": "Abrir a tela do monitor", "url": "./monitor.html", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Controle", "short_name": "Controle", "description": "Abrir o controle remoto", "url": "./controle.html", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] }
  ]
}
